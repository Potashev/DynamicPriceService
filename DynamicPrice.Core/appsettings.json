{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"ConnectionStrings": {
		"DynamicPriceDb": "Server=(localdb)\\mssqllocaldb;Database=DynamicPriceDb;Trusted_Connection=True;MultipleActiveResultSets=true",
		"IdentityDb": "Server=(localdb)\\mssqllocaldb;Database=IdentityDb;Trusted_Connection=True;MultipleActiveResultSets=true"
	},
	"Quartz": {
		"ReducePriceJob": "0/1 * * * * ?"
	},
	"Jwt": {
		"Key": "SuperSecretKey_32bytesMinimumLength!!!!",
		"Issuer": "TestIssuer",
		"Audience": "TestAudience",
		"ExpireMinutes": 60
	},
	"Kestrel": {
		"Endpoints": {
			"Https": {
				"Url": "https://localhost:7140"
			},
			"Http": {
				"Url": "http://localhost:5001"
			}
		}
	}
}
