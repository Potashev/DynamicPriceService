@using DynamicPrice.Shared.Contracts.ViewModels
@model CartViewModel

@{
	ViewData["Title"] = "Cart";

	if (Model is null)return;

	var hasItems = Model.CartItems?.Any() == true;
	var companyTitle = Model.Company?.Title ?? "Company";
}

<h1>@companyTitle — Cart details</h1>

@if (hasItems)
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Product</th>
				<th>Description</th>
				<th>Quantity</th>
				<th>Price</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.CartItems!)
			{
				var product = item.Product;

				<tr>
					<td>@product?.Title</td>
					<td>@product?.Description</td>
					<td>@item.Quantity</td>
					<td>@product?.Price</td>
					<td>
						<form asp-controller="Cart" asp-action="AddCartItem" method="post" class="d-inline">
							<input type="hidden" name="productId" value="@product?.ProductId" />
							<button type="submit" class="btn btn-link p-0">Add</button>
						</form>
						|
						<form asp-controller="Cart" asp-action="RemoveCartItem" method="post" class="d-inline">
							<input type="hidden" name="productId" value="@product?.ProductId" />
							<button type="submit" class="btn btn-link p-0">Remove</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">Cart is empty.</div>
}

<div>
	@if (hasItems)
	{
		<form asp-controller="CustomerOrder" asp-action="Confirm" method="post" class="d-inline">
			<input type="hidden" name="cartId" value="@Model.CartId" />
			<button type="submit" class="btn btn-primary">Confirm order</button>
		</form>
		<span>|</span>
	}

	<a asp-controller="Companies"
		   asp-action="CompanyProducts"
		   asp-route-id="@Model.Company?.CompanyId">
		Back to List
	</a>
</div>