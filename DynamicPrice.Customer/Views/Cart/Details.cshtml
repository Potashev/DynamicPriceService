@using DynamicPrice.Shared.Contracts.ViewModels
@model CartViewModel

@{
	ViewData["Title"] = "Cart";
	if (Model is null) return;
}

<h1>@(Model?.Company?.Title ?? "Company") — Cart details</h1>

@if (Model?.CartItems != null && Model.CartItems.Any())	//todo: make better
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Product</th>
				<th>Description</th>
				<th>Quantity</th>
				<th>Price</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.CartItems)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Product!.Title)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Product!.Description)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Quantity)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Product!.Price)
					</td>
					<td>
						<a asp-action="AddCartItem" asp-route-productId="@item.Product?.ProductId">Add</a> |
						<a asp-action="RemoveCartItem" asp-route-productId="@item.Product?.ProductId">Remove</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">Cart is empty.</div>
}

<div>
	@if (Model?.CartItems != null && Model.CartItems.Any())
	{
		<a asp-controller="CustomerOrder" asp-action="Confirm" asp-route-cartId="@Model?.CartId" class="btn btn-primary">Confirm order</a>
		@: |
	}
	<a asp-controller="Companies" asp-action="CompanyProducts" asp-route-id="@Model?.Company?.CompanyId">Back to List</a>
</div>