@using DynamicPrice.Shared.Contracts.ViewModels.Responses
@model CompanyProductsInfo
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<h1>@Model.Company.Title</h1>

<p>
	<a asp-controller="Cart" asp-action="Details" asp-route-companyId="@Model.Company.CompanyId">Cart Details</a>
</p>

<price-monitor-resources />

<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Products.ElementAt(0).Title)</th>
			<th>@Html.DisplayNameFor(model => model.Products.ElementAt(0).PriceDynamics)</th>
			<th>@Html.DisplayNameFor(model => model.Products.ElementAt(0).Price)</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var product in Model.Products)
		{
			<tr>
				<td>@product.Title</td>
				<td>
					<price-monitor product-id="@product.ProductId"
								   price="@product.Price"
								   price-dynamics="@product.PriceDynamics"
								   max-points="@Model.PriceHistoryLimit">
					</price-monitor>
				</td>
				<td>
					<span id="price-@product.ProductId">@product.Price</span>
					<span id="price-change-@product.ProductId" class="price-change"></span>
				</td>
				<td>
					<a asp-controller="Cart" asp-action="AddProduct" asp-route-productId="@product.ProductId">Add to Cart</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<style>
	.price-change {
		margin-left: 8px;
		font-weight: bold;
	}

	.price-up {
		color: green;
	}

	.price-down {
		color: red;
	}
</style>
