@using DynamicPrice.Shared.Contracts
@model DynamicPrice.Shared.Contracts.ViewModels.CustomerInfoViewModel

@{
	ViewData["Title"] = "Customer info";
	var readyForReceiveOrders = Model.Orders
		.Where(o => o.Status == OrderStatus.Ready)
		.OrderBy(o => o.OrderDate);
}

<h1>Customer @Model.Name</h1>

<div>
	<h2>Details</h2>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Name)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Name)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Email)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Email)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Balance)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Balance) $
		</dd>
	</dl>
</div>
<form asp-action="TopUpBalance">
	@Html.AntiForgeryToken()
	<label>Top up the balance:</label>
	<input type="text" name="replenishmentAmount" />
	<input type="submit" value="Top up" class="btn btn-primary" />
</form>

@if (readyForReceiveOrders.Any())
{
	<h2>Ready for receive</h2>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Number)</th>
				<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Company.Title)</th>
				<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().OrderDate)</th>
				<th></th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in readyForReceiveOrders)
			{
				<tr>
					<td>@Html.DisplayFor(modelItem => item.Number)</td>
					<td>@Html.DisplayFor(modelItem => item.Company.Title)</td>
					<td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
					<td>
						<form asp-controller="CustomerOrder" asp-action="GetReceiveKey" method="get" style="display:inline;">
							<input type="hidden" name="receiveKey" value="@item.ReceiveKey" />
							<input type="hidden" name="orderId" value="@item.OrderId" />
							<button type="submit" class="btn btn-primary btn-sm">Receive Key</button>
						</form>
					</td>
					<td>
						<a asp-controller="CustomerOrder" asp-action="Details" asp-route-id="@item.OrderId">Details</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

<h2>Orders history</h2>
<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Number)</th>
			<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Company.Title)</th>
			<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().OrderDate)</th>
			<th>@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Status)</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.Orders)
		{
			<tr>
				<td>@Html.DisplayFor(modelItem => item.Number)</td>
				<td>@Html.DisplayFor(modelItem => item.Company.Title)</td>
				<td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
				<td><order-status status="@(DynamicPrice.Client.Infrastructure.TagHelpers.OrderStatus)item.Status"></order-status></td>
				<td><a asp-controller="CustomerOrder" asp-action="Details" asp-route-id="@item.OrderId">Details</a></td>
			</tr>
		}
	</tbody>
</table>
