@using DynamicPrice.Shared.Contracts
@model DynamicPrice.Shared.Contracts.ViewModels.OrderViewModel

@{
	ViewData["Title"] = "Details";
}

<h1>Order @Model.Number</h1>
<h2>Products</h2>
<table class="table table-striped">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.OrderItems.FirstOrDefault().Product.Title)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrderItems.FirstOrDefault().ProductPrice)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.OrderItems.FirstOrDefault().Quantity)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.OrderItems)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Product.Title)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.ProductPrice)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Quantity)
				</td>
			</tr>
		}
	</tbody>
</table>

<div>
	<h2>Details</h2>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Number)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Number)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.OrderDate)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.OrderDate)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Company.Title)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Company.Title)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.OrderTotal)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.OrderTotal)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Status)
		</dt>
		<dd class="col-sm-10">
			<order-status status="@(DynamicPrice.Client.Infrastructure.TagHelpers.OrderStatus)Model.Status"></order-status>
		</dd>
	</dl>

	@if (Model.Status is OrderStatus.Confirmed or OrderStatus.Ready)
	{
		<form asp-action="GetReceiveKey" method="get" style="display:inline;">
			<input type="hidden" name="receiveKey" value="@Model.ReceiveKey" />
			<input type="hidden" name="orderId" value="@Model.OrderId" />
			<button type="submit" class="btn btn-primary"
					@(Model.Status is OrderStatus.Confirmed ? "disabled" : null)>
				Receive Key
			</button>
		</form>
		<span> | </span>
		<form asp-action="Cancel" method="post" style="display:inline;">
			<input type="hidden" name="orderId" value="@Model.OrderId" />
			<button type="submit" class="btn btn-danger">Cancel Order</button>
		</form>
		<span> | </span>
	}
	<a asp-controller="Customer" asp-action="Index">Back to List</a>
</div>
