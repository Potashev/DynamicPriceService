@using DynamicPrice.Client.Infrastructure
@using DynamicPrice.Shared.Contracts
@using DynamicPrice.Shared.Contracts.ViewModels
@model OrderViewModel

@{
	ViewData["Title"] = "Details";
	if (Model is null || !Model.OrderItems.Any()) return;
}

<h1>Details</h1>
<h2>Order products</h2>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(m => m.OrderItems.ElementAt(0).Product.Title)
			</th>
			<th>
				@Html.DisplayNameFor(m => m.OrderItems.ElementAt(0).ProductPrice)
			</th>
			<th>
				@Html.DisplayNameFor(m => m.OrderItems.ElementAt(0).Quantity)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.OrderItems)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Product.Title)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.ProductPrice)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Quantity)
				</td>
				<td>
					<a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product.ProductId">Details</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<div>
	<h2>Order details</h2>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Number)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Number)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.OrderDate)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.OrderDate)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.CustomerName)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.CustomerName)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.OrderTotal)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.OrderTotal)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Status)
		</dt>
		<dd class="col-sm-10">
			<order-status status="@(DynamicPrice.Client.Infrastructure.TagHelpers.OrderStatus)Model.Status"></order-status>
		</dd>
	</dl>

	@if (Model.Status is OrderStatus.Confirmed or OrderStatus.Ready)
	{
		<form asp-action="ReadyForReceive" method="post" style="display:inline;">
			<input type="hidden" name="orderId" value="@Model.OrderId" />
			<button type="submit" class="btn btn-primary"
					@(Model.Status is OrderStatus.Ready ? "disabled" : null)>
				Ready for receive
			</button>
		</form>
		<span> | </span>
		<form asp-action="Complete" method="post" style="display:inline;">
			<input type="hidden" name="orderId" value="@Model.OrderId" />
			<button type="submit" class="btn btn-primary"
					@(Model.Status is OrderStatus.Confirmed ? "disabled" : null)>
				Complete
			</button>
		</form>
		<span> | </span>
	}
	<a asp-action="Index">Back to List</a>
</div>
