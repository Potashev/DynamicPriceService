@using DynamicPrice.Shared.Contracts
@using DynamicPrice.Shared.Contracts.ViewModels
@model IEnumerable<OrderViewModel>

@{
	ViewData["Title"] = "Index";
	if (Model is null) return;
	var confirmedOrders = Model
		.Where(o => o.Status == OrderStatus.Confirmed)
		.OrderBy(o => o.OrderDate);
}


<h2>Complete order</h2>

@* todo: try to validate *@
<div class="row">
	<div class="col-md-4">
		<form asp-action="FindByReceiveKey" method="get">
			<label>Enter the receive key:</label>
			<input type="text" name="key" />
			<input type="submit" value="Find order" class="btn btn-primary" />
		</form>
	</div>
</div>

@if (confirmedOrders.Any())
{
	<h2>Confirmed</h2>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>@Html.DisplayNameFor(model => model.Number)</th>
				<th>@Html.DisplayNameFor(model => model.CustomerName)</th>
				<th>@Html.DisplayNameFor(model => model.OrderDate)</th>
				<th></th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in confirmedOrders)
			{
				<tr>
					<td>@Html.DisplayFor(modelItem => item.Number)</td>
					<td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
					<td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
					<td>
						<form asp-action="ReadyForReceive" asp-route-orderId="@item.OrderId" method="post" style="display:inline;">
							<button type="submit" class="btn btn-primary btn-sm">Ready for receive</button>
						</form>
					</td>
					<td>
						<a asp-action="Details" asp-route-id="@item.OrderId">Details</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

<h2>Orders history</h2>

<div class="mb-3">
	<a asp-action="Statistics" asp-route-id="" class="btn btn-primary">Sales analysis</a>
</div>

<label class="mb-3 d-block">
	<input type="checkbox" id="hideVirtualCheckbox" checked />
	Hide virtual orders

	<span title="Virtual orders are generated by a virtual customers — a synthetic users used to demonstrate how the service works."
		  style="cursor: help; margin-left: 5px;">
		ℹ️
	</span>
</label>

<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Number)</th>
			<th>@Html.DisplayNameFor(model => model.CustomerName)</th>
			<th>@Html.DisplayNameFor(model => model.OrderDate)</th>
			<th>@Html.DisplayNameFor(model => model.Status)</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			var isVirtual = string.IsNullOrEmpty(item.CustomerName);

			<tr class="order-row @(isVirtual ? "virtual-order" : "")">
				<td>@Html.DisplayFor(modelItem => item.Number)</td>
				<td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
				<td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
				<td><order-status status="@(DynamicPrice.Client.Infrastructure.TagHelpers.OrderStatus)item.Status"></order-status></td>
				<td><a asp-action="Details" asp-route-id="@item.OrderId">Details</a></td>
			</tr>
		}
	</tbody>
</table>

<script>
	const checkbox = document.getElementById('hideVirtualCheckbox');

	checkbox.addEventListener('change', () => {
		document.querySelectorAll('.virtual-order').forEach(row => {
			row.style.display = checkbox.checked ? 'none' : '';
		});
	});

	document.querySelectorAll('.virtual-order').forEach(row => {
		row.style.display = 'none';
	});
</script>