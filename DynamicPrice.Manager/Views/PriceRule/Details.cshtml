@using DynamicPrice.Shared.Contracts.ViewModels
@using DynamicPrice.Shared.Contracts.ViewModels.Responses
@model PriceRuleWithStatus

@{
	ViewData["Title"] = "Details";
	if (Model is null) return;
}

<h1>Details</h1>

<div>
	<h4>PriceRule</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.PriceRule.Increase)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.PriceRule.Increase) %
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.PriceRule.Reduction)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.PriceRule.Reduction) %
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.PriceRule.NoSellTime)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.PriceRule.NoSellTime)
		</dd>
		<dt class="col-sm-2">
			Status
		</dt>
		<dd class="col-sm-10">
			@(Model.IsActive ? "Running" : "Not running")
		</dd>
	</dl>
</div>
<div>
	<form asp-action="Run" method="post" style="display:inline">
		<input type="hidden" name="id" value="@Model?.PriceRule.PriceRuleId" />
		<button type="submit" class="btn btn-primary">Run</button>
	</form>
	<span>|</span>
	<form asp-action="Stop" method="post" style="display:inline">
		<input type="hidden" name="id" value="@Model?.PriceRule.PriceRuleId" />
		<button type="submit" class="btn btn-primary">Stop</button>
	</form>
	<span>|</span>
	<a asp-action="Edit" asp-route-id="@Model?.PriceRule.PriceRuleId">Edit</a>
</div>
