@model DynamicPrice.Shared.Contracts.ViewModels.ProductViewModel

@{
	ViewData["Title"] = "Details";
}

<h1>Details</h1>

<price-monitor-resources />

<div>
	<h4>Product</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Title)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
		<dd class="col-sm-10">
			<span id="price-@Model.ProductId">@Html.DisplayFor(model => model.Price)</span>
			<span id="price-change-@Model.ProductId" class="price-change"></span>
		</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.MinimumPrice)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.MinimumPrice)</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Quantity)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
	</dl>
</div>

<price-monitor product-id="@Model.ProductId"
			   price="@Model.Price"
			   dynamics="@Model.PriceDynamics"
			   max-points="300"
			   show-axes="true"
			   show-grid="true">
</price-monitor>

<div>
	<a asp-action="Edit" asp-route-id="@Model?.ProductId">Edit</a> |
	<a asp-action="Index">Back to List</a>
</div>

<style>
	.chart-container {
		width: 600px;
		height: 300px;
		margin: 20px 0;
	}

	.price-change {
		margin-left: 8px;
		font-weight: bold;
	}

	.price-up {
		color: green;
	}

	.price-down {
		color: red;
	}
</style>
@section Scripts {
	<script>
		(function() {
			var productId = @Model.ProductId;
			function subscribe() {
				if (window.priceMonitorInstance && typeof window.priceMonitorInstance.subscribeToProduct === "function") {
					window.priceMonitorInstance.subscribeToProduct(productId)
						.catch(function (e) { console.error("subscribeToProduct failed", e); });
				}
			}
			// если monitor уже готов
			if (window.priceMonitorInstance) {
				subscribe();
			} else {
				// ждём события и подписываемся
				window.addEventListener('priceMonitorReady', subscribe, { once: true });
			}
		})();
	</script>
}