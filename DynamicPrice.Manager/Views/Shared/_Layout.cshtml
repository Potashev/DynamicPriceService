<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - DynamicPriceService</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand">DynamicPrice.Manager</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

					<ul class="navbar-nav">
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller="Products" asp-action="Index">Products</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller="CompanyOrders" asp-action="Index">Orders</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller="PriceRule" asp-action="Details">Price Rule</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark" asp-controller="Managers" asp-action="Index">Managers</a>
						</li>
					</ul>

					<div class="d-flex align-items-center gap-3">

						@if (CurrentUser.IsAuthenticated)
						{
							<span class="navbar-text bg-light px-2 py-1 rounded fw-semibold">
								@CurrentUser.CompanyTitle
							</span>
							<span> | </span>
							<form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
								<button type="submit" class="nav-link btn btn-link text-dark p-0">
									Logout
								</button>
							</form>
						}
						else
						{
							<a class="nav-link text-dark" asp-controller="Auth" asp-action="LoginManager">
								Login
							</a>
						}

					</div>

				</div>

			</div>

		</nav>
	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
			<error-alert />
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2026 - DynamicPriceService
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
