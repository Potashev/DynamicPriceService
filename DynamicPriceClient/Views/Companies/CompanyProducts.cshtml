@model DynamicPriceClient.ViewModels.CompanyProductsInfo

<h1>@Model.Company.Title</h1>

<p>
	<a asp-controller="Cart" asp-action="Details" asp-route-companyId="@Model.Company.CompanyId">Cart Details</a>
</p>

<!-- ✅ подключаем наш компонент из RCL -->
<price-monitor hub-url="/priceHub" history-days="3"></price-monitor>

<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().Title)</th>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().PriceDynamics)</th>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().Price)</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var product in Model.Products)
		{
			<tr>
				<td>@product.Title</td>
				<td>
					<div class="chart-container">
						<canvas id="chart-@product.ProductId"></canvas>
					</div>

					<!-- ✅ регистрация чарта через JS из RCL -->
					<script>
						PriceMonitor.registerChart(@product.ProductId,
							@Html.Raw(Json.Serialize(
								Model.Products
										.First(p => p.ProductId == product.ProductId)
										.PriceDynamics
										.Select(d => new { price = d.Price, date = d.Date })
												)));
				</script>
			</td>
			<td id="price-@product.ProductId">@product.Price</td>
			<td>
				<a asp-controller="Cart" asp-action="AddProduct" asp-route-productId="@product.ProductId">
					Add to Cart
				</a>
			</td>
		</tr>
				}
	</tbody>
</table>

<style>
	.chart-container {
		width: 340pt;
		height: 175pt;
		border: 1px solid #ccc;
		padding: 5px;
		margin: 10px 0;
		background-color: #f0f0f0;
		box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
		border-radius: 5px;
	}
</style>
