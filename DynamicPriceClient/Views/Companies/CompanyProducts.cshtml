@model DynamicPriceClient.ViewModels.CompanyProductsInfo

ё<h1>Product Prices</h1>

<table class="table">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().Title)</th>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().Price)</th>
			<th>Price Change Graph</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var product in Model.Products)
		{
			<tr>
				<td>@product.Title</td>
				<td id="price-@product.ProductId">@product.Price</td>
				<td>
					<div class="chart-container">
						<canvas id="chart-@product.ProductId" width="400" height="200"></canvas>
					</div>
				</td>
				<td>
					<a asp-controller="Orders" asp-action="AddProduct" asp-route-id="@product.ProductId">Add to Cart</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

<script>
	// Создание соединения с хабом SignalR
	var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7140/priceHub").build();

	// Массив для хранения графиков
	var charts = {};

	// Запуск соединения
	connection.start().then(function () {
		   console.log("SignalR connected");
	}).catch(function (err) {
		   console.error("SignalR connection error: ", err);
	});

	// Получение обновлений цены от сервера
	connection.on("ReceivePriceUpdate", function (productId, newPrice) {
		   updateChart(productId, newPrice);
		   updatePriceLabel(productId, newPrice);
	});

	// Функция для обновления графика при изменении цены
	function updateChart(productId, newPrice) {
		   var chart = charts[productId];
		   if (chart) {
				  chart.data.datasets[0].data.push(newPrice);  // Добавление новой цены
				  chart.data.labels.push(new Date().toLocaleTimeString());  // Добавление времени изменения цены

				  // Ограничиваем количество точек на графике (например, до 10)
				  if (chart.data.datasets[0].data.length > 10) {
						 chart.data.datasets[0].data.shift();  // Удаляем старую цену
						 chart.data.labels.shift();  // Удаляем старую метку времени
				  }

				  chart.update();  // Обновляем график
		   }
	}

	// Функция для обновления отображаемой цены
	function updatePriceLabel(productId, newPrice) {
		document.getElementById('price-' + productId).innerText = newPrice;
	 }

	// Отрисовка графиков для каждого продукта
	@foreach (var product in Model.Products)
	{
		<text>
				   drawChart(@product.ProductId);
		</text>
	}

	   // Функция для создания графика
		  function drawChart(productId) {
			  var ctx = document.getElementById('chart-' + productId).getContext('2d');
				 var chart = new Chart(ctx, {
					 type: 'line',
						data: {
							labels: [],  // Начальные пустые метки
							   datasets: [{
								   label: 'Price Change',
								   data: [],  // Начальные пустые данные
								   borderColor: 'rgba(75, 192, 192, 1)',
								   borderWidth: 2,
								fill: false
						 }]
					 },
						options: {
							   scales: {
									  x: { display: false },  // Ось X скрыта
									  y: { display: false }   // Ось Y скрыта
								  },
							   plugins: {
						              legend: { display: false }
							   }
						   }
					   });

						  // Сохраняем график по ID продукта
						  charts[productId] = chart;
	 }
</script>

<style>
	.chart-container {
		border: 2px solid #000; /* Цвет и толщина рамки */
		padding: 10px; /* Отступы вокруг графика */
		background-color: #f9f9f9; /* Цвет фона */
	}
</style>