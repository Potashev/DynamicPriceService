@model DynamicPriceClient.ViewModels.CompanyProductsInfo

<h1>@Model.Company.Title</h1>

<p>
	<a asp-controller="Cart" asp-action="Details" asp-route-companyId="@Model.Company.CompanyId">Cart Details</a>
</p>

<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().Title)</th>
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().PriceDynamics)</th>
			@* <th>Price dynamics</th> *@
			<th>@Html.DisplayNameFor(model => model.Products.FirstOrDefault().Price)</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var product in Model.Products)
		{
			<tr>
				<td>@product.Title</td>
				<td>
					<div class="chart-container">
						<canvas id="chart-@product.ProductId" @* width="100" height="50" *@></canvas>
					</div>
				</td>
				<td>
					<span id="price-@product.ProductId">@product.Price</span>
					<span id="price-change-@product.ProductId" class="price-change"></span>
				</td>
				<td>
					<a asp-controller="Cart" asp-action="AddProduct" asp-route-productId="@product.ProductId">Add to Cart</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

<link rel="stylesheet" href="~/_content/DynamicPrice.Client.Common/css/price-monitor.css" />
<script type="module" src="~/_content/DynamicPrice.Client.Common/js/price-monitor.js"></script>

<script type="module">
	import { PriceMonitor } from '/_content/DynamicPrice.Client.Common/js/price-monitor.js';
	import { PriceMonitorConfig } from '/_content/DynamicPrice.Client.Common/js/price-monitor-config.js';

	const config = new PriceMonitorConfig({
		maxPoints: 20,
		chartOptions: {
			scales: { y: { display: false }, x: { display: false } }
		}
	});

	const priceMonitor = new PriceMonitor("https://localhost:7140/priceHub", config);
	await priceMonitor.init();

	@foreach (var product in Model.Products)
	{
			<text>
				priceMonitor.registerChart(
					@product.ProductId,
					"chart-@product.ProductId",
						@Html.Raw(Json.Serialize(product.PriceDynamics.Select(d => new { date = d.Date, price = d.Price })))
				);
			</text>
	}
</script>

<style>
	.price-change {
		margin-left: 8px;
		font-weight: bold;
	}

	.price-up {
		color: green;
	}

	.price-down {
		color: red;
	}
</style>
