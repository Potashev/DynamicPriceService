@model IEnumerable<DynamicPriceClient.ViewModels.CompanyViewModel>

@{
	ViewData["Title"] = "Index";
}

<h1>Active Companies</h1>

@if (Model != null && Model.Any())
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.Title)
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						<a asp-action="CompanyProducts" asp-route-id="@item.CompanyId">@Html.DisplayFor(modelItem => item.Title)</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">No active companies found.</div>
}
