@model DynamicPriceClient.ViewModels.CustomerInfoViewModel

@{
	ViewData["Title"] = "Customer info";
}

<div>
	<h4>Customer info</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Name)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Name)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Balance)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Balance) $
		</dd>
	</dl>
</div>
<form asp-action="TopUpBalance">
	@Html.AntiForgeryToken()
	<label>Top up the balance:</label>
	<input type="text" name="replenishmentAmount" />
	<input type="submit" value="Top up" class="btn btn-primary" />
</form>

<h2>Orders history</h2>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Company.Title)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().OrderDate)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Orders.FirstOrDefault().Status)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.Orders)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Company.Title)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.OrderDate)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Status)
				</td>
				<td>
					<a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId">Details</a>
				</td>
			</tr>
		}
	</tbody>
</table>
