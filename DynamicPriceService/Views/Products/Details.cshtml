@model DynamicPriceService.ViewModels.ProductViewModel

@{
	ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
	<h4>Product</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Title)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
		<dd class="col-sm-10">
			<span id="price-@Model.ProductId">@Html.DisplayFor(model => model.Price)</span>
			<span id="price-change-@Model.ProductId" class="price-change"></span>
		</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.MinimumPrice)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.MinimumPrice)</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Quantity)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>

		<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
	</dl>
</div>

<div class="chart-container">
	<canvas id="chart-@Model.ProductId"></canvas>
</div>

<div>
	<a asp-action="Edit" asp-route-id="@Model?.ProductId">Edit</a> |
	<a asp-action="Index">Back to List</a>
</div>

<!-- Подключаем Chart.js и SignalR -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

<!-- Подключаем наш RCL для мониторинга цен -->
<link rel="stylesheet" href="~/_content/DynamicPrice.Client.Common/css/price-monitor.css" />
<script type="module" src="~/_content/DynamicPrice.Client.Common/js/price-monitor.js"></script>

<script type="module">
	import { PriceMonitor } from '/_content/DynamicPrice.Client.Common/js/price-monitor.js';
	import { PriceMonitorConfig } from '/_content/DynamicPrice.Client.Common/js/price-monitor-config.js';

	const config = new PriceMonitorConfig({
		maxPoints: 100,
		chartOptions: {
			scales: {
				y: { display: true },
				x: { display: true }
			}
		}
	});

	const priceMonitor = new PriceMonitor("https://localhost:7140/priceHub", config);
	await priceMonitor.init();

	priceMonitor.registerChart(
		@Model.ProductId,
		"chart-@Model.ProductId",
		@Html.Raw(Json.Serialize(Model.PriceDynamics.Select(d => new { date = d.Date, price = d.Price })))
	);
</script>

<style>
	.chart-container {
		width: 600px;
		height: 300px;
		margin: 20px 0;
	}

	.price-change {
		margin-left: 8px;
		font-weight: bold;
	}

	.price-up {
		color: green;
	}

	.price-down {
		color: red;
	}
</style>
